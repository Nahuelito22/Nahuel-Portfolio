---
// src/components/Header.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  /**
   * URL de ESTA misma pagina en el otro idioma. La pasa el Layout, que ya la
   * calcula para el hreflang. Sin esto, el switcher de una subpagina te tira a
   * la portada en vez de al equivalente traducido.
   */
  langToggleHref?: string;
}

const { langToggleHref } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = lang === "en" ? "/en/" : "/";

// En una subpagina (un caso de estudio) las anclas sueltas no apuntan a nada:
// esas secciones viven en la portada. Hay que prefijarlas con la home.
// En la portada se dejan relativas para no recargar la pagina.
const path = Astro.url.pathname;
const isHome = path === "/" || path === "/en" || path === "/en/";
const anchor = (hash: string) => (isHome ? hash : `${home}${hash}`);

const navItems = [
  { label: t("nav.home"), url: isHome ? "#" : home },
  { label: t("nav.saas"), url: anchor("#saas-production") },
  { label: t("nav.projects"), url: anchor("#proyectos") },
  { label: t("nav.about"), url: anchor("#sobre-mi") },
  { label: t("nav.cert"), url: anchor("#certificados") },
  { label: t("nav.services"), url: anchor("#servicios") },
  { label: t("nav.contact"), url: anchor("#contacto") },
];

const targetUrl = langToggleHref ?? (lang === "es" ? "/en/" : "/");
---

<header class="fixed top-0 w-full z-50 transition-all duration-300" id="navbar">
  <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
    <a
      href={isHome ? "#" : home}
      class="text-xl font-bold font-mono text-white hover:text-ai-neon transition-colors"
    >
      &lt;Nahu /&gt;
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {
        navItems.map((link) => (
          <a
            href={link.url}
            class="text-sm font-medium text-gray-300 hover:text-ai-neon transition-colors relative group"
          >
            {link.label}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-ai-neon transition-all group-hover:w-full" />
          </a>
        ))
      }

      <!-- Language Toggle (Desktop) -->
      <a
        href={targetUrl}
        class="flex items-center gap-2 px-3 py-1 rounded border border-gray-700 text-gray-400 font-mono text-xs hover:border-ai-neon hover:text-ai-neon hover:bg-ai-neon/10 transition-all"
        aria-label="Toggle language"
      >
        <span class={lang === "es" ? "text-ai-neon font-bold" : "text-gray-400"}
          >ES</span
        >
        <span class="text-gray-600">|</span>
        <span class={lang === "en" ? "text-ai-neon font-bold" : "text-gray-400"}
          >EN</span
        >
      </a>
    </nav>

    <div class="md:hidden flex items-center gap-4 relative z-50">
      <!-- Language Toggle (Mobile) -->
      <a
        href={targetUrl}
        class="flex items-center gap-2 px-2 py-1 rounded border border-gray-700 text-gray-400 font-mono text-xs hover:border-ai-neon hover:text-ai-neon hover:bg-ai-neon/10 transition-all"
        aria-label="Toggle language"
      >
        <span class={lang === "es" ? "text-ai-neon font-bold" : "text-gray-400"}
          >ES</span
        >
        <span class="text-gray-600">|</span>
        <span class={lang === "en" ? "text-ai-neon font-bold" : "text-gray-400"}
          >EN</span
        >
      </a>

      <!-- Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="text-gray-300 hover:text-ai-neon transition-colors p-2 focus:outline-none"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu-overlay"
      >
        <svg
          id="menu-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-6 h-6 transition-transform duration-300"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
        <svg
          id="menu-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-6 h-6 hidden transition-transform duration-300"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-chess-dark/95 backdrop-blur-xl z-40 hidden flex-col justify-center items-center opacity-0 transition-opacity duration-300"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-ai-neon/10 via-transparent to-transparent pointer-events-none"
  >
  </div>
  <nav class="flex flex-col items-center gap-8 w-full px-6 relative z-10">
    {
      navItems.map((link) => (
        <a
          href={link.url}
          class="mobile-nav-link text-2xl font-bold text-gray-300 hover:text-ai-neon transition-colors w-full text-center py-4 border-b border-white/5"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  // Script para efecto "Glass" al hacer scroll y Menú Móvil
  document.addEventListener("astro:page-load", () => {
    // --- Lógica del Scroll (Glass Effect) ---
    const navbar = document.getElementById("navbar");
    if (navbar) {
      const handleScroll = () => {
        if (window.scrollY > 50) {
          navbar.classList.add(
            "bg-chess-dark/80",
            "backdrop-blur-md",
            "border-b",
            "border-white/10",
          );
        } else {
          navbar.classList.remove(
            "bg-chess-dark/80",
            "backdrop-blur-md",
            "border-b",
            "border-white/10",
          );
        }
      };
      handleScroll();
      window.addEventListener("scroll", handleScroll);
    }

    // --- Lógica del Menú Móvil ---
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileOverlay = document.getElementById("mobile-menu-overlay");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    if (mobileBtn && mobileOverlay && iconOpen && iconClose) {
      let isMenuOpen = false;

      const toggleMenu = () => {
        isMenuOpen = !isMenuOpen;
        // El icono cambia, pero un lector de pantalla necesita el estado
        mobileBtn.setAttribute("aria-expanded", String(isMenuOpen));

        if (isMenuOpen) {
          // Abrir Menú
          mobileOverlay.classList.remove("hidden");
          // Pequeño delay para que la transición de opacidad funcione
          setTimeout(() => {
            mobileOverlay.classList.remove("opacity-0");
            mobileOverlay.classList.add("opacity-100");
          }, 10);

          iconOpen.classList.add("hidden");
          iconClose.classList.remove("hidden");
          document.body.style.overflow = "hidden"; // Prevenir scroll de la página de fondo
        } else {
          // Cerrar Menú
          mobileOverlay.classList.remove("opacity-100");
          mobileOverlay.classList.add("opacity-0");

          setTimeout(() => {
            mobileOverlay.classList.add("hidden");
          }, 300); // Esperar que termine la transición (300ms)

          iconClose.classList.add("hidden");
          iconOpen.classList.remove("hidden");
          document.body.style.overflow = ""; // Restaurar scroll
        }
      };

      mobileBtn.addEventListener("click", toggleMenu);

      // Cerrar al hacer click en un link
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          if (isMenuOpen) toggleMenu();
        });
      });
    }
  });
</script>
