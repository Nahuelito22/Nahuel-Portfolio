---
// src/components/Header.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  /**
   * URL de ESTA misma pagina en el otro idioma. La pasa el Layout, que ya la
   * calcula para el hreflang. Sin esto, el switcher de una subpagina te tira a
   * la portada en vez de al equivalente traducido.
   */
  langToggleHref?: string;
}

const { langToggleHref } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const home = lang === "en" ? "/en/" : "/";

// En una subpagina (un caso de estudio) las anclas sueltas no apuntan a nada:
// esas secciones viven en la portada. Hay que prefijarlas con la home.
// En la portada se dejan relativas para no recargar la pagina.
const path = Astro.url.pathname;
const isHome = path === "/" || path === "/en" || path === "/en/";
const anchor = (hash: string) => (isHome ? hash : `${home}${hash}`);

// Menu corto a proposito: la experiencia y el contacto son lo que importa.
// "Proyectos" apunta a la seccion vieja hasta que exista la de Casos.
const navItems = [
  { label: t("nav.experience"), url: anchor("#experiencia") },
  { label: t("nav.projects"), url: anchor("#proyectos") },
  { label: t("nav.about"), url: anchor("#sobre-mi") },
];
const contactUrl = anchor("#contacto");

const targetUrl = langToggleHref ?? (lang === "es" ? "/en/" : "/");
---

<header class="fixed top-0 w-full z-50 transition-all duration-300" id="navbar">
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-3 md:py-5 flex justify-between items-center">
    <a
      href={isHome ? "#" : home}
      class="font-serif font-semibold text-[19px] md:text-[21px] tracking-[-0.01em] text-ink hover:text-white transition-colors"
    >
      Nahuel Ghilardi<span class="text-accent">.</span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-[15px]">
      {
        navItems.map((link) => (
          <a href={link.url} class="text-muted hover:text-ink transition-colors">
            {link.label}
          </a>
        ))
      }

      <a
        href={targetUrl}
        class="text-sm text-faint hover:text-ink transition-colors"
        aria-label={lang === "es" ? "Switch to English" : "Cambiar a español"}
      >
        <span class={lang === "es" ? "text-ink font-medium" : ""}>ES</span>
        <span class="mx-1">|</span>
        <span class={lang === "en" ? "text-ink font-medium" : ""}>EN</span>
      </a>

      <a
        href={contactUrl}
        class="border border-accent text-accent px-4 py-2 rounded-sm font-medium text-sm hover:bg-accent hover:text-chess-dark transition-colors"
      >
        {t("nav.contact")}
      </a>
    </nav>

    <div class="md:hidden flex items-center gap-2 relative z-50">
      <a
        href={targetUrl}
        class="text-sm text-faint px-2 py-3"
        aria-label={lang === "es" ? "Switch to English" : "Cambiar a español"}
      >
        <span class={lang === "es" ? "text-ink font-medium" : ""}>ES</span>
        <span class="mx-1">|</span>
        <span class={lang === "en" ? "text-ink font-medium" : ""}>EN</span>
      </a>

      <button
        id="mobile-menu-btn"
        class="text-ink w-11 h-11 flex items-center justify-center focus:outline-none focus-visible:ring-1 focus-visible:ring-accent"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu-overlay"
      >
        <svg
          id="menu-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.6"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          id="menu-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.6"
          stroke="currentColor"
          class="w-6 h-6 hidden"
        >
          <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-chess-dark/95 backdrop-blur-xl z-40 hidden flex-col justify-center items-center opacity-0 transition-opacity duration-300"
>
  <nav class="flex flex-col items-center w-full px-6">
    {
      [...navItems, { label: t("nav.contact"), url: contactUrl }].map((link) => (
        <a
          href={link.url}
          class="mobile-nav-link font-serif text-3xl text-ink hover:text-accent transition-colors w-full text-center py-5 border-b border-line"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  // Script para efecto "Glass" al hacer scroll y Menú Móvil
  document.addEventListener("astro:page-load", () => {
    // --- Lógica del Scroll (Glass Effect) ---
    const navbar = document.getElementById("navbar");
    if (navbar) {
      const handleScroll = () => {
        if (window.scrollY > 50) {
          navbar.classList.add(
            "bg-chess-dark/85",
            "backdrop-blur-md",
            "border-b",
            "border-line",
          );
        } else {
          navbar.classList.remove(
            "bg-chess-dark/85",
            "backdrop-blur-md",
            "border-b",
            "border-line",
          );
        }
      };
      handleScroll();
      window.addEventListener("scroll", handleScroll);
    }

    // --- Lógica del Menú Móvil ---
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileOverlay = document.getElementById("mobile-menu-overlay");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    if (mobileBtn && mobileOverlay && iconOpen && iconClose) {
      let isMenuOpen = false;

      const toggleMenu = () => {
        isMenuOpen = !isMenuOpen;
        // El icono cambia, pero un lector de pantalla necesita el estado
        mobileBtn.setAttribute("aria-expanded", String(isMenuOpen));

        if (isMenuOpen) {
          // Abrir Menú
          mobileOverlay.classList.remove("hidden");
          // Pequeño delay para que la transición de opacidad funcione
          setTimeout(() => {
            mobileOverlay.classList.remove("opacity-0");
            mobileOverlay.classList.add("opacity-100");
          }, 10);

          iconOpen.classList.add("hidden");
          iconClose.classList.remove("hidden");
          document.body.style.overflow = "hidden"; // Prevenir scroll de la página de fondo
        } else {
          // Cerrar Menú
          mobileOverlay.classList.remove("opacity-100");
          mobileOverlay.classList.add("opacity-0");

          setTimeout(() => {
            mobileOverlay.classList.add("hidden");
          }, 300); // Esperar que termine la transición (300ms)

          iconClose.classList.add("hidden");
          iconOpen.classList.remove("hidden");
          document.body.style.overflow = ""; // Restaurar scroll
        }
      };

      mobileBtn.addEventListener("click", toggleMenu);

      // Cerrar al hacer click en un link
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          if (isMenuOpen) toggleMenu();
        });
      });
    }
  });
</script>
