---
// src/components/CaseStudy.astro
//
// Render de un caso de estudio. La estructura sigue el orden del BACKLOG:
// problema -> solucion -> resultado -> stack. El stack va ultimo y en letra
// chica a proposito: el visitante que decide una contratacion no llega por el
// stack, llega por el problema.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { TESTIMONIALS } from "../data/testimonials";
import type { CaseStudy } from "../data/cases";

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = study.content[lang === "en" ? "en" : "es"];

const home = lang === "en" ? "/en/" : "/";

// Las citas viven en testimonials.ts; aca se referencian por autor para no
// duplicar el texto ni arriesgar que las dos copias diverjan.
const quotes = TESTIMONIALS.filter((item) =>
  study.testimonialAuthors.includes(item.author),
);

const blocks = [
  { n: "01", label: t("case.problem"), body: content.problem },
  { n: "02", label: t("case.solution"), body: content.solution },
  { n: "03", label: t("case.result"), body: content.result },
];
---

<article class="max-w-3xl mx-auto px-4 md:px-8 pt-28 md:pt-36 pb-20 md:pb-28">
  <a
    href={`${home}#casos`}
    class="inline-flex items-center gap-2 text-sm text-faint hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded-sm"
  >
    <span aria-hidden="true">←</span>
    {t("case.back")}
  </a>

  <!-- Encabezado -->
  <header class="mt-10 md:mt-12">
    <p class="text-sm md:text-[15px] font-medium text-accent">
      {t("case.badge")} · <span class="text-faint font-normal">{study.period}</span>
    </p>
    <div class="mt-3 flex items-center gap-4">
      <div
        class="w-12 h-12 md:w-14 md:h-14 border border-line-strong bg-surface flex items-center justify-center overflow-hidden shrink-0"
      >
        <img
          src={study.image}
          alt=""
          width="56"
          height="56"
          decoding="async"
          class="w-full h-full object-contain p-1.5"
        />
      </div>
      <h1
        class="font-serif font-medium text-[2.25rem] md:text-[3.25rem] leading-[1.05] tracking-[-0.03em]"
      >
        {study.product}
      </h1>
    </div>
    <p class="mt-6 text-lg md:text-xl leading-relaxed text-muted text-pretty">
      {content.tagline}
    </p>
  </header>

  <!-- Metricas -->
  {
    study.metrics.length > 0 && (
      <div class="mt-10 py-6 border-y border-line grid grid-cols-2 sm:flex sm:flex-wrap gap-x-12 gap-y-6">
        {study.metrics.map((metric) => (
          <div>
            <p class="font-serif font-semibold text-3xl md:text-4xl leading-none">{metric.value}</p>
            <p class="mt-2 text-[13px] text-muted max-w-[14rem]">{t(metric.labelKey as any)}</p>
          </div>
        ))}
      </div>
    )
  }

  <!-- Problema / Solucion / Resultado -->
  <div class="mt-14 flex flex-col gap-12">
    {
      blocks.map((block) => (
        <section>
          <div class="flex items-baseline gap-3">
            <span class="text-sm text-accent/60 select-none tabular-nums">{block.n}</span>
            <h2 class="font-serif font-semibold text-2xl md:text-[1.75rem] tracking-[-0.01em]">
              {block.label}
            </h2>
          </div>
          <p class="mt-3 text-soft leading-relaxed text-base md:text-lg">{block.body}</p>
        </section>
      ))
    }
  </div>

  <!-- Testimonios reales del producto -->
  {
    quotes.length > 0 && (
      <section class="mt-16">
        <h2 class="font-serif font-semibold text-2xl md:text-[1.75rem] tracking-[-0.01em]">
          {t("case.voices")}
        </h2>
        <div class="mt-6 flex flex-col gap-4">
          {quotes.map((item) => (
            <figure class="bg-surface/90 border border-line rounded-md p-6">
              <blockquote class="font-serif text-lg leading-relaxed text-ink">
                “{item.quote}”
              </blockquote>
              <figcaption class="mt-4 pt-4 border-t border-line text-sm">
                <span class="font-medium text-ink">{item.author}</span>
                <span class="text-faint"> · {t(item.roleKey)}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-4 text-xs text-faint">
          {t("testimonials.disclaimer")}{" "}
          <a
            href={study.link}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 hover:text-accent transition-colors"
          >
            {study.link?.replace(/^https?:\/\//, "").replace(/\/$/, "")}
          </a>
        </p>
      </section>
    )
  }

  <!-- Stack, al final y en letra chica -->
  <section class="mt-16 pt-8 border-t border-line">
    <h2 class="text-xs tracking-[0.06em] uppercase text-faint">{t("case.stack")}</h2>
    <p class="mt-3 text-sm text-muted leading-relaxed">{content.stackNote}</p>
    <p class="mt-4 text-[13px] text-faint leading-relaxed">{study.stack.join(" · ")}</p>
  </section>

  <!-- Cierre: las dos acciones posibles -->
  <section class="mt-16 border border-line-strong bg-surface/90 p-7 md:p-9">
    <h2 class="font-serif font-medium text-[1.75rem] md:text-[2rem] tracking-[-0.02em]">
      {t("case.cta.title")}
    </h2>
    <p class="mt-3 text-muted leading-relaxed max-w-xl">{t("case.cta.text")}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={`${home}#contacto`}
        class="bg-ink text-chess-dark px-6 py-3.5 rounded-sm font-semibold text-[15px] hover:bg-white transition-colors"
      >
        {t("case.cta.btn")}
      </a>
      {
        study.link && (
          <a
            href={study.link}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[#2F3541] text-ink px-6 py-3.5 rounded-sm font-medium text-[15px] hover:border-accent hover:text-accent transition-colors"
          >
            {t("case.visit")} ↗
          </a>
        )
      }
    </div>
  </section>
</article>
