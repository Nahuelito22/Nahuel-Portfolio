---
// src/components/Services.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { SERVICES } from "../data/services";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="servicios" class="relative py-20 z-10">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Header de la sección -->
    <div class="mb-16 text-center md:text-left flex flex-col items-center md:items-start">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 mb-6">
            <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
            <span class="text-purple-400 text-sm font-mono tracking-widest uppercase">System.Freelance.ENV</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
            {t("services.title1")}<span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-ai-neon">{t("services.title2")}</span>
        </h2>
        <div class="w-full h-px bg-gradient-to-r from-purple-500/50 via-ai-neon/50 to-transparent mt-4 max-w-2xl"></div>
        <p class="text-gray-400 mt-4 text-center md:text-left max-w-xl">
            {t("services.subtitle")}
        </p>
    </div>

    <!-- Grilla de Tiers -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {SERVICES.map((tier) => {
        const isFeatured = tier.featured;

        return (
          <div 
            class={`service-card relative group flex flex-col justify-between p-6 sm:p-8 bg-chess-board/60 backdrop-blur-md rounded-2xl border transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl hover:shadow-ai-neon/5 ${
              isFeatured 
                ? 'border-ai-neon/30 shadow-lg shadow-ai-neon/5' 
                : 'border-white/5'
            } hover:border-ai-neon/50`}
          >
            {isFeatured && (
              <div class="absolute inset-0 bg-gradient-to-b from-ai-neon/5 to-transparent rounded-2xl pointer-events-none opacity-50 group-hover:opacity-100 transition-opacity duration-300"></div>
            )}

            {tier.badgeKey && (
              <div class="absolute -top-3 right-6 px-3 py-1 rounded-full bg-ai-neon text-chess-dark text-[10px] font-mono font-bold uppercase tracking-wider shadow-lg shadow-ai-neon/20">
                {t(tier.badgeKey)}
              </div>
            )}

            <div>
              <!-- Icono -->
              <div class="w-12 h-12 rounded-xl bg-chess-dark/85 border border-white/10 flex items-center justify-center mb-6 group-hover:border-ai-neon/30 transition-colors duration-300">
                {tier.icon === "web" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-ai-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                  </svg>
                )}
                {tier.icon === "saas" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-ai-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3V7.5a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3v3.75a3 3 0 0 1-3 3M5.25 14.25a3 3 0 0 0-3 3v3.75a3 3 0 0 0 3 3h13.5a3 3 0 0 0 3-3v-3.75a3 3 0 0 0-3-3M6 9h.008v.008H6V9Zm.008 7.5H6V16h.008v.008Zm0 3H6v-.008h.008v.008Z" />
                  </svg>
                )}
                {tier.icon === "brain" && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-ai-neon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                )}
              </div>

              <!-- Título & Descripción -->
              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-ai-neon transition-colors duration-300 font-mono">
                {t(tier.titleKey)}
              </h3>
              <p class="text-sm text-gray-400 mb-6 leading-relaxed">
                {t(tier.descriptionKey)}
              </p>

              <!-- Características -->
              <ul class="flex flex-col gap-3.5 mb-8">
                {tier.itemsKeys.map((itemKey) => (
                  <li class="flex items-start gap-2.5 text-sm text-gray-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-ai-neon shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                    <span>{t(itemKey)}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Footer: Precio & CTA -->
            <div class="mt-auto pt-6 border-t border-white/5 flex flex-col gap-4">
              <div>
                <span class="text-[10px] text-gray-500 font-mono uppercase tracking-wider block mb-1">Inversión Estimada</span>
                <span class="text-2xl font-bold text-white font-mono">{t(tier.priceKey)}</span>
              </div>
              
              <a 
                href="#contacto" 
                class={`w-full py-3 rounded-xl font-bold text-center transition-all duration-300 text-sm flex items-center justify-center gap-1.5 group/btn ${
                  isFeatured 
                    ? 'bg-ai-neon text-chess-dark hover:bg-white hover:shadow-lg hover:shadow-ai-neon/20' 
                    : 'bg-chess-dark/80 border border-white/10 text-white hover:bg-white/5 hover:border-ai-neon/30'
                }`}
              >
                <span>{t("services.cta")}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover/btn:translate-x-0.5 transition-transform"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
