---
// src/components/Services.astro
//
// Cuatro servicios en texto, sin precios, iconos ni badges. Un solo llamado a
// la accion al final: la conversacion arranca en Contacto.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { SERVICES } from "../data/services";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="servicios" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
  <p class="text-sm md:text-[15px] font-medium text-accent">{t("services.eyebrow")}</p>
  <h2
    class="mt-1.5 md:mt-2 font-serif font-medium text-[1.875rem] md:text-[2.75rem] leading-[1.15] md:leading-[1.12] tracking-[-0.02em] max-w-2xl text-balance"
  >
    {t("services.title")}
  </h2>

  <div class="mt-8 md:mt-12 grid gap-4 md:gap-6 md:grid-cols-2">
    {
      SERVICES.map((s) => (
        <article class="bg-surface/90 border border-line rounded-md p-[22px] md:p-7">
          <h3 class="font-serif font-semibold text-[21px] md:text-2xl tracking-[-0.01em]">{s.title[lang]}</h3>
          <p class="mt-3 text-[15px] md:text-base leading-relaxed text-soft">{s.description[lang]}</p>
        </article>
      ))
    }
  </div>

  <p class="mt-8 text-[15px] md:text-base text-muted">
    {t("services.ctaText")}{" "}
    <a href="#contacto" class="text-accent hover:text-[#8ADDE7] transition-colors">{t("services.cta")} →</a>
  </p>
</section>
