---
// src/components/Skills.astro
//
// Stack en filas de texto, sin iconos ni tarjetas: se lee de un vistazo y no
// compite con los casos, que son los que cuentan como se usa cada cosa.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { STACK } from "../data/stack";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="stack" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
  <p class="text-sm md:text-[15px] font-medium text-accent">{t("stack.eyebrow")}</p>
  <h2
    class="mt-1.5 md:mt-2 font-serif font-medium text-[1.875rem] md:text-[2.75rem] leading-[1.15] md:leading-[1.12] tracking-[-0.02em] max-w-2xl text-balance"
  >
    {t("stack.title")}
  </h2>

  <dl class="mt-8 md:mt-12 border-t border-line">
    {
      STACK.map((group) => (
        <div class="py-5 border-b border-line md:grid md:grid-cols-[220px_minmax(0,1fr)] md:gap-8 md:items-baseline">
          <dt class="font-serif font-semibold text-lg md:text-xl tracking-[-0.01em]">{group.label[lang]}</dt>
          <dd class="mt-1.5 md:mt-0 text-[15px] md:text-base leading-relaxed text-soft">
            {group.items.join(" · ")}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
