---
// src/components/ProductionSaaS.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const products = [
  {
    title: "AstroFit",
    description: t("saas.af.desc"),
    tags: ["Astro", "Supabase", "TypeScript", "Playwright"],
    status: t("saas.status.active"),
    metrics: [
      { value: "3+", label: t("saas.metrics.clients") },
      { value: "80+", label: t("saas.metrics.users") }
    ],
    image: "/projects/astrofit.webp",
    badges: ["SaaS", "B2B"],
    link: "https://www.astrofitapp.com.ar/",
    isReady: true
  },
  {
    title: "TupRun",
    description: t("saas.tr.desc"),
    statusDetailed: t("saas.tr.status_detailed"),
    tags: ["Next.js", "React Native", "PostgreSQL", "Stripe"],
    status: t("saas.status.dev"),
    metrics: [
      { value: "---", label: t("saas.metrics.clients") },
      { value: "---", label: t("saas.metrics.users") }
    ],
    image: "/projects/TupRun_Sin_Fondo.webp",
    badges: ["SaaS", "Event Management"],
    isReady: false
  }
];
---

<section id="saas-production" class="relative py-20 z-10">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Header de la sección -->
    <div class="mb-16 text-center md:text-left flex flex-col items-center md:items-start">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/20 mb-6">
            <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
            <span class="text-purple-400 text-sm font-mono tracking-widest uppercase">System.Production.ENV</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
            {t("saas.title1")}<span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-ai-neon">{t("saas.title2")}</span>
        </h2>
        <div class="w-full h-px bg-gradient-to-r from-purple-500/50 via-ai-neon/50 to-transparent mt-4 max-w-2xl"></div>
    </div>

    <!-- Grilla principal -->
    <div class="flex flex-col gap-12">
        {products.map((product) => (
            <div class={`relative group flex flex-col ${product.isReady ? 'md:flex-row' : 'md:flex-row-reverse'} bg-chess-board rounded-3xl border ${product.isReady ? 'border-ai-neon/20 hover:border-ai-neon/50' : 'border-purple-500/20 hover:border-purple-500/50'} overflow-hidden transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl ${product.isReady ? 'hover:shadow-ai-neon/20' : 'hover:shadow-purple-500/20'}`}>
                
                <!-- Columna de Imagen -->
                <div class="w-full md:w-1/2 relative min-h-[300px] md:min-h-[400px] bg-chess-dark overflow-hidden flex items-center justify-center">
                    <div class={`absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] ${product.isReady ? 'from-ai-neon via-chess-dark to-chess-dark' : 'from-purple-500 via-chess-dark to-chess-dark'}`}></div>
                    
                    {product.image ? (
                        <div class="relative w-full h-full p-8 flex items-center justify-center">
                             <img src={product.image} alt={product.title} class="w-full h-full object-contain rounded-xl shadow-2xl drop-shadow-2xl group-hover:scale-105 transition-transform duration-700 ease-out z-10 relative" />
                        </div>
                    ) : (
                        <div class="relative z-10 flex flex-col items-center justify-center text-center p-8">
                            <span class="text-7xl mb-4 opacity-50 drop-shadow-2xl group-hover:scale-110 transition-transform duration-500">🏃</span>
                            <div class="px-6 py-2 rounded-full border border-purple-500/30 bg-purple-500/10 backdrop-blur-md">
                                <span class="text-purple-400 font-mono font-bold tracking-widest">{t("saas.soon")}</span>
                            </div>
                        </div>
                    )}
                </div>

                <!-- Columna de Contenido -->
                <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-between relative">
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-chess-dark/50 z-0"></div>
                    
                    <div class="relative z-10">
                        <div class="flex flex-wrap gap-2 mb-6">
                            {product.badges.map(badge => (
                                <span class="px-3 py-1 text-xs font-mono font-bold tracking-wider rounded bg-white/5 border border-white/10 text-gray-300">
                                    {badge}
                                </span>
                            ))}
                        </div>

                        <div class="flex items-center justify-between mb-4">
                            <h3 class={`text-3xl md:text-4xl font-bold ${product.isReady ? 'text-white' : 'text-gray-300'} group-hover:text-white transition-colors`}>
                                {product.title}
                            </h3>
                            <div class="flex items-center gap-2">
                                <span class={`relative flex h-3 w-3`}>
                                  <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${product.isReady ? 'bg-ai-neon' : 'bg-purple-500'}`}></span>
                                  <span class={`relative inline-flex rounded-full h-3 w-3 ${product.isReady ? 'bg-ai-neon' : 'bg-purple-500'}`}></span>
                                </span>
                                <span class={`text-xs font-mono hidden sm:inline-block ${product.isReady ? 'text-ai-neon' : 'text-purple-400'}`}>
                                    {product.status}
                                </span>
                            </div>
                        </div>

                        <p class="text-gray-400 leading-relaxed mb-6">
                            {product.description}
                        </p>

                        {product.statusDetailed && (
                            <div class="mb-6 inline-block w-full sm:w-auto px-4 py-3 rounded-lg bg-purple-500/10 border border-purple-500/30 text-purple-300 text-sm shadow-inner shadow-purple-500/10">
                                <p class="leading-relaxed">
                                    {product.statusDetailed}
                                </p>
                            </div>
                        )}

                        <!-- Métricas del mundo real -->
                        <div class="grid grid-cols-2 gap-4 mb-8">
                            {product.metrics.map(metric => (
                                <div class="p-4 rounded-xl bg-chess-dark/50 border border-white/5 flex flex-col items-center sm:items-start text-center sm:text-left">
                                    <span class={`text-2xl font-bold ${product.isReady ? 'text-white' : 'text-gray-500'}`}>{metric.value}</span>
                                    <span class="text-xs text-gray-500 font-mono mt-1">{metric.label}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="relative z-10 mt-auto flex flex-col sm:flex-row items-center justify-between gap-6">
                        <div class="flex flex-wrap gap-2 w-full sm:w-auto">
                            {product.tags.map(tag => (
                                <span class={`text-xs font-mono px-2 py-1 rounded bg-chess-dark border ${product.isReady ? 'border-ai-neon/20 text-ai-neon/80' : 'border-purple-500/20 text-purple-400/80'}`}>
                                    {tag}
                                </span>
                            ))}
                        </div>

                        {product.isReady && product.link ? (
                            <a 
                                href={product.link} 
                                target="_blank"
                                class="w-full sm:w-auto px-8 py-3 rounded-xl bg-ai-neon text-chess-dark font-bold text-center hover:bg-white hover:shadow-lg hover:shadow-ai-neon/50 transition-all flex justify-center items-center gap-2 group/btn shrink-0"
                            >
                                <span>{t("saas.visit")}</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover/btn:translate-x-1 transition-transform"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                            </a>
                        ) : (
                             <button disabled class="w-full sm:w-auto px-8 py-3 rounded-xl bg-chess-dark border border-purple-500/50 text-purple-400/50 font-bold text-center cursor-not-allowed shrink-0">
                                {t("saas.soon")}
                            </button>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>

  </div>
</section>
