---
// src/components/Testimonials.astro
//
// En la landing va solo la cita marcada con `showOnLanding`. Las demas viven
// en el caso de estudio de su producto, que muestra todas. El porque esta
// documentado en testimonials.ts.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { TESTIMONIALS } from "../data/testimonials";
import { CASES } from "../data/cases";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = TESTIMONIALS.filter((item) => item.showOnLanding);

// Si la cita destacada pertenece a un producto que tiene caso de estudio, se
// enlaza: ahi estan las otras y la historia completa.
const relatedCase = CASES.find((c) =>
  featured.some((item) => item.product === c.product),
);
const casePrefix = lang === "en" ? "/en/cases/" : "/casos/";
---

<section id="testimonios" class="py-20 relative z-10">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-white mb-4">
        {t("testimonials.title1")}
        <span class="text-ai-neon">{t("testimonials.title2")}</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        {t("testimonials.subtitle")}
      </p>
    </div>

    <div
      class={
        featured.length === 1
          ? "max-w-2xl mx-auto"
          : "grid grid-cols-1 md:grid-cols-3 gap-6"
      }
    >
      {
        featured.map((item) => (
          <figure class="flex flex-col h-full bg-chess-board/60 backdrop-blur-md border border-white/10 rounded-2xl p-6 md:p-8 hover:border-ai-neon/30 transition-colors duration-300">
            <svg
              class="w-8 h-8 text-ai-neon/30 mb-4 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M9.5 5C6.5 7 5 9.8 5 13.3V19h6.2v-6.2H8.3c0-2.3.9-4.1 2.7-5.4L9.5 5zm9 0c-3 2-4.5 4.8-4.5 8.3V19h6.2v-6.2h-2.9c0-2.3.9-4.1 2.7-5.4L18.5 5z" />
            </svg>

            <blockquote class="flex-1 text-gray-300 leading-relaxed mb-6 text-lg">
              {item.quote}
            </blockquote>

            <figcaption class="border-t border-white/10 pt-4 mt-auto">
              <div class="font-bold text-white">{item.author}</div>
              <div class="text-sm text-gray-500">
                {t(item.roleKey)} · {t("testimonials.about")} {item.product}
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    {
      relatedCase && (
        <p class="text-center mt-8">
          <a
            href={`${casePrefix}${relatedCase.slug}/`}
            data-analytics={`testimonials-case-${relatedCase.slug}`}
            class="inline-flex items-center gap-1.5 text-sm text-ai-neon/80 hover:text-ai-neon transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-neon focus-visible:ring-offset-2 focus-visible:ring-offset-chess-dark rounded"
          >
            {t("testimonials.readCase")}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </p>
      )
    }

    <p class="text-center text-xs text-gray-600 mt-6">
      {t("testimonials.disclaimer")}
      <a
        href="https://www.astrofitapp.com.ar/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-500 hover:text-ai-neon underline underline-offset-2 transition-colors"
      >
        astrofitapp.com.ar
      </a>
    </p>
  </div>
</section>
