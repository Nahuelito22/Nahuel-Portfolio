---
// src/components/Hero.astro
//
// Primer pantallazo: quien soy (titulo), que hago (bajada) y la ficha con la
// foto y el estado actual. La ficha reemplaza a los contadores de clientes y
// usuarios, que envejecian solos: una linea de "Hoy" se actualiza sin mentir.
//
// El nombre no se repite aca: ya esta en la navbar.
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fields = [
  { label: t("hero.card.base"), value: t("hero.card.baseValue") },
  { label: t("hero.card.available"), value: t("hero.card.availableValue") },
];
---

<section
  id="inicio"
  class="max-w-6xl mx-auto px-4 md:px-8 pt-28 md:pt-40 pb-20 md:pb-28 grid md:grid-cols-[minmax(0,1fr)_340px] gap-10 md:gap-20 items-center"
>
  <div>
    <h1
      class="font-serif font-medium text-[2.5rem] leading-[1.07] md:text-7xl md:leading-[1.04] tracking-[-0.03em] text-balance"
    >
      {t("hero.title")}
    </h1>
    <p class="mt-5 md:mt-7 text-[17px] md:text-[19px] leading-relaxed text-muted max-w-xl">
      <strong class="text-ink font-medium">{t("hero.leadStrong")}</strong>{t("hero.lead")}
    </p>

    <div class="mt-8 md:mt-9 hidden md:flex gap-3.5">
      <a
        href="#contacto"
        class="bg-ink text-chess-dark px-6 py-3.5 rounded-sm font-semibold text-[15px] hover:bg-white transition-colors"
      >
        {t("hero.contactBtn")}
      </a>
      <a
        href="/CV-Nahuel.pdf"
        download
        class="border border-[#2F3541] text-ink px-6 py-3.5 rounded-sm font-medium text-[15px] hover:border-accent hover:text-accent transition-colors"
      >
        {t("hero.cvBtn")}
      </a>
    </div>
  </div>

  <!-- Ficha: foto + estado. En movil queda horizontal para no ocupar toda la
       pantalla antes de que aparezcan los botones. -->
  <aside
    class="relative mx-2 md:mx-0 border border-line-strong bg-surface/90 grid grid-cols-[124px_minmax(0,1fr)] md:block"
  >
    <span
      aria-hidden="true"
      class="absolute -left-2 -top-2 md:-left-[9px] md:-top-[9px] w-3.5 h-3.5 md:w-4 md:h-4 border-l-[1.5px] border-t-[1.5px] border-accent"
    ></span>
    <span
      aria-hidden="true"
      class="absolute -right-2 -bottom-2 md:-right-[9px] md:-bottom-[9px] w-3.5 h-3.5 md:w-4 md:h-4 border-r-[1.5px] border-b-[1.5px] border-accent"
    ></span>

    <img
      src="/profile.webp"
      alt={t("hero.photoAlt")}
      width="338"
      height="360"
      class="w-[124px] h-full md:w-full md:h-[360px] object-cover block saturate-[.8] contrast-[1.03] border-r md:border-r-0 md:border-b border-line-strong"
    />

    <div class="flex flex-col">
      <div class="px-3 py-2.5 md:px-[18px] md:py-[13px] border-b border-line flex-grow">
        <p class="text-[11px] md:text-xs tracking-[0.06em] uppercase text-accent">
          {t("hero.card.now")}
        </p>
        <p class="mt-0.5 text-sm md:text-[15px] leading-snug">{t("hero.card.nowValue")}</p>
      </div>
      <div class="hidden md:grid grid-cols-2 border-b border-line">
        {
          fields.map((f, i) => (
            <div class:list={["px-[18px] py-[13px]", i === 0 && "border-r border-line"]}>
              <p class="text-xs tracking-[0.06em] uppercase text-faint">{f.label}</p>
              <p class="mt-0.5 text-[15px]">{f.value}</p>
            </div>
          ))
        }
      </div>
      <!-- En movil no entra la grilla de dos: queda solo la base. -->
      <div class="md:hidden px-3 py-2.5 border-b border-line">
        <p class="text-[11px] tracking-[0.06em] uppercase text-faint">{fields[0].label}</p>
        <p class="mt-0.5 text-sm">{fields[0].value}</p>
      </div>
      <div class="px-3 py-2.5 md:px-[18px] md:py-[13px]">
        <p class="text-[11px] md:text-xs tracking-[0.06em] uppercase text-faint">
          {t("hero.card.focus")}
        </p>
        <p class="mt-0.5 text-sm md:text-[15px] leading-snug">{t("hero.card.focusValue")}</p>
      </div>
    </div>
  </aside>

  <!-- Botones en movil: despues de la ficha, a lo ancho y faciles de tocar. -->
  <div class="md:hidden flex flex-col gap-2.5">
    <a
      href="#contacto"
      class="bg-ink text-chess-dark px-5 py-3.5 rounded-sm font-semibold text-[15px] text-center"
    >
      {t("hero.contactBtn")}
    </a>
    <a
      href="/CV-Nahuel.pdf"
      download
      class="border border-[#2F3541] text-ink px-5 py-3.5 rounded-sm font-medium text-[15px] text-center"
    >
      {t("hero.cvBtn")}
    </a>
  </div>
</section>
