---
// src/components/Hero.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:4rem_4rem]"
    >
    </div>
  </div>

  <div
    class="absolute top-1/4 left-1/4 w-96 h-96 bg-ai-neon rounded-full mix-blend-screen filter blur-[128px] opacity-10 animate-pulse pointer-events-none"
  >
  </div>

  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tight">
      {t("hero.hello")}<span
        class="text-transparent bg-clip-text bg-gradient-to-r from-ai-neon to-purple-500"
        >Nahu</span
      >.
    </h1>

    <p
      class="text-xl md:text-2xl text-chess-accent mb-6 max-w-2xl mx-auto font-light"
    >
      {t("hero.role")}
      <br />
      <span class="text-base md:text-lg mt-3 block text-gray-300">
        {t("hero.subtitle")}
      </span>
    </p>

    <!-- Prueba dura: lo que ya está funcionando, no lo que sé hacer.
         Las etiquetas son genéricas a propósito: el hero es el lugar más
         visible del sitio y nombrar un rubro acá encasilla toda la práctica.
         El dato de que los clientes son gimnasios está más abajo, en
         Producción y Testimonios, donde ser específico es prueba y no límite.

         Reglas para tocar estos números: solo cuentan cosas ya entregadas, y
         cada uno tiene que poder desglosarse si un cliente pregunta. Un número
         que no se puede explicar cuesta más de lo que suma. -->
    <div
      class="grid grid-cols-3 divide-x divide-white/10 mb-10 max-w-lg mx-auto"
    >
      {
        [
          { value: "2", label: t("hero.stats.apps") },
          { value: "5", label: t("hero.stats.clients") },
          { value: "250+", label: t("hero.stats.users") },
        ].map((stat) => (
          <div class="flex flex-col items-center justify-start px-2">
            <span class="text-2xl md:text-3xl font-bold text-ai-neon leading-none">
              {stat.value}
            </span>
            <span class="text-[10px] md:text-xs text-gray-400 uppercase tracking-wider mt-2 text-center leading-tight">
              {stat.label}
            </span>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
      <a
        href="#proyectos"
        class="group relative px-8 py-3 bg-white text-chess-dark font-bold rounded hover:bg-ai-neon transition-colors duration-300"
      >
        {t("hero.projectsBtn")}
        <span
          class="absolute -right-2 -top-2 w-4 h-4 bg-chess-dark border border-ai-neon rounded-full opacity-0 group-hover:opacity-100 transition-all"
        ></span>
      </a>

      <a
        href="#contacto"
        class="px-8 py-3 border border-chess-accent text-chess-accent hover:text-white hover:border-white rounded transition-colors duration-300"
      >
        {t("hero.contactBtn")}
      </a>
    </div>
  </div>

  <div
    class="absolute bottom-10 animate-bounce text-chess-accent opacity-50 pointer-events-none"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
