---
// src/components/About.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="sobre-mi" class="py-20 bg-chess-board/50 relative overflow-hidden">
  <div
    class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"
  >
  </div>

  <div
    class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center gap-12"
  >
    <div class="md:w-1/2">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-ai-neon/10 border border-ai-neon/20 mb-6"
      >
        <span class="w-2 h-2 rounded-full bg-ai-neon animate-pulse"></span>
        <span class="text-ai-neon text-xs font-mono">{t("about.label")}</span>
      </div>

      <h2 class="text-4xl font-bold text-white mb-6">
        {t("about.title1")}<span
          class="text-transparent bg-clip-text bg-gradient-to-r from-ai-neon to-purple-400"
          >{t("about.title2")}</span
        >.
      </h2>

      <div class="space-y-4 text-gray-400 leading-relaxed">
        <p>
          {t("about.p1.1")}<strong>Tupungato, Mendoza</strong>{t("about.p1.2")}
          <span class="text-white font-medium">Electromecánica</span>{
            t("about.p1.3")
          }
        </p>

        <p>
          {t("about.p2.1")}
          <strong>Data Science</strong>{t("about.p2.2")}<strong
            >Desarrollo de Software</strong
          >{t("about.p2.3")}
        </p>

        <p>
          {t("about.p3.1")}
          <span class="text-ai-neon">red neuronal LSTM</span>{t("about.p3.2")}
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4 mt-8">
        <div
          class="p-4 bg-chess-dark border border-white/5 rounded-lg hover:border-ai-neon/30 transition-colors"
        >
          <h4 class="text-ai-neon font-bold text-2xl">2+</h4>
          <p class="text-xs text-gray-500 font-mono">
            {t("about.stats.years")}
          </p>
        </div>
        <div
          class="p-4 bg-chess-dark border border-white/5 rounded-lg hover:border-ai-neon/30 transition-colors"
        >
          <h4 class="text-purple-400 font-bold text-2xl">5+</h4>
          <p class="text-xs text-gray-500 font-mono">
            {t("about.stats.projects")}
          </p>
        </div>
      </div>

      <div class="mt-8">
        <a
          href="/CV-Nahuel.pdf"
          download="CV-Nahuel-Ghilardi.pdf"
          class="inline-block w-full text-center md:w-auto px-8 py-3 bg-ai-neon text-chess-dark font-bold rounded-full hover:bg-white transition-all transform hover:scale-105"
        >
          {t("about.cv")}
        </a>
      </div>
    </div>

    <div class="md:w-1/2 relative">
      <div
        class="relative z-10 w-full aspect-square bg-chess-dark border-2 border-white/10 rounded-2xl overflow-hidden group"
      >
        <img
          src="/profile.webp"
          alt="Foto de perfil de Nahu"
          class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-chess-dark via-transparent to-transparent opacity-60"
        >
        </div>
        <div class="absolute bottom-4 left-4">
          <p class="text-white font-mono text-sm">Matias Nahuel Ghilardi</p>
          <p class="text-ai-neon text-xs font-mono">{t("about.role")}</p>
        </div>
      </div>

      <div
        class="absolute -inset-4 border border-ai-neon/20 rounded-2xl -z-10 rotate-3"
      >
      </div>
      <div
        class="absolute -inset-4 border border-purple-500/20 rounded-2xl -z-10 -rotate-3"
      >
      </div>
    </div>
  </div>
</section>
