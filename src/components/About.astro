---
// src/components/About.astro
//
// Un texto corto sobre quien soy y como trabajo. Sin foto (ya esta en el hero),
// sin edad y sin contadores: lo que diferencia es el contexto, no los numeros.
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const facts = [
  { label: t("about.fact.base"), value: t("about.fact.baseValue") },
  { label: t("about.fact.studies"), value: t("about.fact.studiesValue") },
  { label: t("about.fact.community"), value: t("about.fact.communityValue") },
  { label: t("about.fact.work"), value: t("about.fact.workValue") },
];
---

<section id="sobre-mi" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
  <div class="md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-20">
    <div>
      <p class="text-sm md:text-[15px] font-medium text-accent">{t("about.eyebrow")}</p>
      <h2
        class="mt-1.5 md:mt-2 font-serif font-medium text-[1.875rem] md:text-[2.75rem] leading-[1.15] md:leading-[1.12] tracking-[-0.02em] text-balance"
      >
        {t("about.title")}
      </h2>
      <div class="mt-6 md:mt-8 space-y-5 text-base md:text-[17px] leading-relaxed text-soft max-w-2xl">
        <p>{t("about.p1")}</p>
        <p>{t("about.p2")}</p>
        <p>{t("about.p3")}</p>
      </div>
    </div>

    <dl class="mt-10 md:mt-16 border-t border-line">
      {
        facts.map((f) => (
          <div class="py-4 border-b border-line">
            <dt class="text-xs tracking-[0.06em] uppercase text-faint">{f.label}</dt>
            <dd class="mt-1 text-[15px] text-ink">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
