---
// src/components/Footer.astro
//
// Pie sobrio. El unico guiño que queda en todo el sitio es el caballo: una
// referencia a Roque Chess y al ajedrez, sin "Powered by" ni chistes legales.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { SOCIALS } from "../config/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-line">
  <div
    class="max-w-6xl mx-auto px-4 md:px-8 py-8 flex flex-col md:flex-row gap-4 md:items-center md:justify-between text-sm text-faint"
  >
    <p>&copy; {currentYear} {t("footer.rights")}</p>
    <div class="flex items-center gap-6">
      <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors"
        >GitHub</a
      >
      <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors"
        >LinkedIn</a
      >
      <span aria-hidden="true" title="Roque Chess" class="text-base text-muted">♞</span>
    </div>
  </div>
</footer>
