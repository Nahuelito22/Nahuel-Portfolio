---
// src/components/Contact.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { EMAIL, WHATSAPP } from "../config/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Si no hay numero cargado en config/site.ts, el boton no se renderiza.
const whatsappUrl = WHATSAPP
  ? `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(t("contact.wa.prefill"))}`
  : null;
---

<section id="contacto" class="py-20">
  <div class="max-w-2xl mx-auto px-4">
    <h2 class="text-4xl font-bold text-white mb-8 text-center">
      {t("contact.title1")}<span class="text-ai-neon"
        >{t("contact.title2")}</span
      >
    </h2>
    <p class="text-center text-gray-400 mb-12">
      {t("contact.subtitle1")}
      <br />{t("contact.subtitle2")}
    </p>

    <!-- Vias directas: mucha gente no completa formularios -->
    <div class="flex flex-wrap justify-center gap-3 mb-10">
      <a
        href={`mailto:${EMAIL}`}
        data-analytics="contact-email"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/10 bg-chess-board text-gray-300 hover:text-ai-neon hover:border-ai-neon/40 transition-colors text-sm"
      >
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 6L2 7"></path>
        </svg>
        {EMAIL}
      </a>

      {
        whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="contact-whatsapp"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-green-500/30 bg-green-500/10 text-green-400 hover:bg-green-500 hover:text-chess-dark transition-colors text-sm font-semibold"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5 4.5.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.2-.3-.2-.5-.4z" />
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z" />
            </svg>
            WhatsApp
          </a>
        )
      }
    </div>

    <div class="flex items-center gap-4 mb-10">
      <div class="flex-1 h-px bg-white/10"></div>
      <span class="text-xs text-gray-600 uppercase tracking-wider"
        >{t("contact.or")}</span
      >
      <div class="flex-1 h-px bg-white/10"></div>
    </div>

    <form
      id="contact-form"
      action="https://formspree.io/f/mkglbpgg"
      method="POST"
      class="space-y-6"
      data-msg-success={t("contact.success")}
      data-msg-error={t("contact.error")}
      data-msg-offline={t("contact.offline")}
      data-mailto={`mailto:${EMAIL}`}
    >
      <!-- Honeypot anti-spam: invisible para personas, tentador para bots.
           Si viene completo, no enviamos. -->
      <div class="absolute w-px h-px -left-[9999px] overflow-hidden" aria-hidden="true">
        <label for="company">No completar este campo</label>
        <input type="text" name="_gotcha" id="company" tabindex="-1" autocomplete="off" />
      </div>

      <div class="relative">
        <input
          type="text"
          name="name"
          id="name"
          required
          class="peer w-full bg-chess-board border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-ai-neon transition-colors"
          placeholder=" "
        />
        <label
          for="name"
          class="absolute left-4 top-3 text-gray-400 transition-all duration-300 peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-ai-neon"
        >
          {t("contact.name")}
        </label>
      </div>

      <div class="relative">
        <input
          type="email"
          name="email"
          id="email"
          required
          class="peer w-full bg-chess-board border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-ai-neon transition-colors"
          placeholder=" "
        />
        <label
          for="email"
          class="absolute left-4 top-3 text-gray-400 transition-all duration-300 peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-ai-neon"
        >
          {t("contact.email")}
        </label>
      </div>

      <div class="relative">
        <textarea
          name="message"
          id="message"
          required
          rows="5"
          class="peer w-full bg-chess-board border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-ai-neon transition-colors"
          placeholder=" "></textarea>
        <label
          for="message"
          class="absolute left-4 top-3 text-gray-400 transition-all duration-300 peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-ai-neon"
        >
          {t("contact.message")}
        </label>
      </div>

      <div class="text-center">
        <button
          type="submit"
          id="contact-submit"
          data-label-idle={t("contact.send")}
          data-label-sending={t("contact.sending")}
          data-analytics="contact-submit"
          class="px-8 py-3 bg-ai-neon text-chess-dark font-bold rounded-full hover:bg-white transition-all transform hover:scale-105 disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:scale-100 disabled:hover:bg-ai-neon"
        >
          {t("contact.send")}
        </button>
      </div>

      <!-- Feedback en la misma pagina: antes el POST nativo se llevaba al
           visitante a formspree.io y no volvia -->
      <div
        id="contact-status"
        role="status"
        aria-live="polite"
        class="hidden text-center text-sm rounded-lg px-4 py-3 border"
      >
      </div>
    </form>
  </div>
</section>

<script>
  // Sin is:inline: los scripts inline se re-ejecutan en cada View Transition y
  // acumularian un listener de submit por navegacion. Este se bundlea y corre una vez.
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("contact-status");
    const button = document.getElementById(
      "contact-submit",
    ) as HTMLButtonElement | null;
    if (!form || !status || !button) return;

    const OK_CLASSES = ["text-ai-neon", "border-ai-neon/30", "bg-ai-neon/5"];
    const ERR_CLASSES = ["text-amber-400", "border-amber-400/30", "bg-amber-400/5"];

    const show = (message: string | undefined, ok: boolean) => {
      status.textContent = message ?? "";
      status.classList.remove("hidden", ...OK_CLASSES, ...ERR_CLASSES);
      status.classList.add(...(ok ? OK_CLASSES : ERR_CLASSES));
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);

      // Honeypot: si un bot lo completo, fingimos exito y descartamos.
      if (data.get("_gotcha")) {
        show(form.dataset.msgSuccess, true);
        form.reset();
        return;
      }

      button.disabled = true;
      button.textContent = button.dataset.labelSending;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          show(form.dataset.msgSuccess, true);
          form.reset();
        } else {
          const body = await response.json().catch(() => null);
          const detail = body?.errors
            ?.map((e: { message: string }) => e.message)
            .join(". ");
          show(detail || form.dataset.msgError, false);
        }
      } catch {
        // Sin red, o Formspree caido: damos una salida, no un callejon.
        show(form.dataset.msgOffline, false);
        const mailto = form.dataset.mailto;
        if (mailto) {
          window.setTimeout(() => {
            window.location.href = mailto;
          }, 1200);
        }
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.labelIdle;
      }
    });
  });
</script>
