---
// src/components/Contact.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { EMAIL, WHATSAPP, SOCIALS } from "../config/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Si no hay numero cargado en config/site.ts, el boton no se renderiza.
const whatsappUrl = WHATSAPP
  ? `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(t("contact.wa.prefill"))}`
  : null;
---

<section id="contacto" class="max-w-6xl mx-auto px-4 md:px-8 py-16 md:py-24">
  <div class="md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:gap-20">
    <div>
      <p class="text-sm md:text-[15px] font-medium text-accent">{t("contact.eyebrow")}</p>
      <h2
        class="mt-1.5 md:mt-2 font-serif font-medium text-[2.25rem] md:text-[3.25rem] leading-[1.1] tracking-[-0.025em]"
      >
        {t("contact.title1")}{t("contact.title2")}
      </h2>
      <p class="mt-5 text-base md:text-[17px] leading-relaxed text-soft max-w-md">
        {t("contact.subtitle1")}
      </p>

      <!-- Vias directas: mucha gente no completa formularios -->
      <p class="mt-10 text-xs tracking-[0.06em] uppercase text-faint">{t("contact.direct")}</p>
      <ul class="mt-2 border-t border-line">
        <li class="border-b border-line">
          <a
            href={`mailto:${EMAIL}`}
            data-analytics="contact-email"
            class="flex justify-between gap-4 py-3.5 text-[15px] text-ink hover:text-accent transition-colors"
          >
            <span class="text-muted">Email</span><span class="truncate">{EMAIL}</span>
          </a>
        </li>
        {
          whatsappUrl && (
            <li class="border-b border-line">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-analytics="contact-whatsapp"
                class="flex justify-between gap-4 py-3.5 text-[15px] text-ink hover:text-accent transition-colors"
              >
                <span class="text-muted">WhatsApp</span><span>↗</span>
              </a>
            </li>
          )
        }
        <li class="border-b border-line">
          <a
            href={SOCIALS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex justify-between gap-4 py-3.5 text-[15px] text-ink hover:text-accent transition-colors"
          >
            <span class="text-muted">LinkedIn</span><span>↗</span>
          </a>
        </li>
        <li class="border-b border-line">
          <a
            href={SOCIALS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex justify-between gap-4 py-3.5 text-[15px] text-ink hover:text-accent transition-colors"
          >
            <span class="text-muted">GitHub</span><span>↗</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-12 md:mt-0">
      <p class="text-xs tracking-[0.06em] uppercase text-faint">{t("contact.form")}</p>
      <form
        id="contact-form"
        action="https://formspree.io/f/mkglbpgg"
        method="POST"
        class="mt-3 border border-line-strong bg-surface/90 p-5 md:p-7 space-y-5"
        data-msg-success={t("contact.success")}
        data-msg-error={t("contact.error")}
        data-msg-offline={t("contact.offline")}
        data-mailto={`mailto:${EMAIL}`}
      >
        <!-- Honeypot anti-spam: invisible para personas, tentador para bots.
             Si viene completo, no enviamos. -->
        <div class="absolute w-px h-px -left-[9999px] overflow-hidden" aria-hidden="true">
          <label for="company">No completar este campo</label>
          <input type="text" name="_gotcha" id="company" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <label for="name" class="block text-sm text-muted">{t("contact.name")}</label>
          <input
            type="text"
            name="name"
            id="name"
            required
            autocomplete="name"
            class="mt-1.5 w-full bg-chess-dark border border-line-strong rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-accent transition-colors"
          />
        </div>

        <div>
          <label for="email" class="block text-sm text-muted">{t("contact.email")}</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            autocomplete="email"
            class="mt-1.5 w-full bg-chess-dark border border-line-strong rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-accent transition-colors"
          />
        </div>

        <div>
          <label for="message" class="block text-sm text-muted">{t("contact.message")}</label>
          <textarea
            name="message"
            id="message"
            required
            rows="5"
            class="mt-1.5 w-full bg-chess-dark border border-line-strong rounded-sm px-4 py-3 text-ink focus:outline-none focus:border-accent transition-colors"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          data-label-idle={t("contact.send")}
          data-label-sending={t("contact.sending")}
          data-analytics="contact-submit"
          class="w-full md:w-auto bg-ink text-chess-dark px-6 py-3.5 rounded-sm font-semibold text-[15px] hover:bg-white transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >
          {t("contact.send")}
        </button>

        <!-- Feedback en la misma pagina: antes el POST nativo se llevaba al
             visitante a formspree.io y no volvia -->
        <div
          id="contact-status"
          role="status"
          aria-live="polite"
          class="hidden text-sm rounded-sm px-4 py-3 border"
        >
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Sin is:inline: los scripts inline se re-ejecutan en cada View Transition y
  // acumularian un listener de submit por navegacion. Este se bundlea y corre una vez.
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("contact-status");
    const button = document.getElementById(
      "contact-submit",
    ) as HTMLButtonElement | null;
    if (!form || !status || !button) return;

    const OK_CLASSES = ["text-accent", "border-accent/30", "bg-accent/5"];
    const ERR_CLASSES = ["text-amber-400", "border-amber-400/30", "bg-amber-400/5"];

    const show = (message: string | undefined, ok: boolean) => {
      status.textContent = message ?? "";
      status.classList.remove("hidden", ...OK_CLASSES, ...ERR_CLASSES);
      status.classList.add(...(ok ? OK_CLASSES : ERR_CLASSES));
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);

      // Honeypot: si un bot lo completo, fingimos exito y descartamos.
      if (data.get("_gotcha")) {
        show(form.dataset.msgSuccess, true);
        form.reset();
        return;
      }

      button.disabled = true;
      button.textContent = button.dataset.labelSending;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          show(form.dataset.msgSuccess, true);
          form.reset();
        } else {
          const body = await response.json().catch(() => null);
          const detail = body?.errors
            ?.map((e: { message: string }) => e.message)
            .join(". ");
          show(detail || form.dataset.msgError, false);
        }
      } catch {
        // Sin red, o Formspree caido: damos una salida, no un callejon.
        show(form.dataset.msgOffline, false);
        const mailto = form.dataset.mailto;
        if (mailto) {
          window.setTimeout(() => {
            window.location.href = mailto;
          }, 1200);
        }
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.labelIdle;
      }
    });
  });
</script>
