---
// src/pages/404.astro
//
// Vercel sirve esta pagina para cualquier ruta que no exista. Es una sola para
// los dos idiomas: el texto va en ambos, y los links llevan a cada portada.
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada | Matías Nahuel Ghilardi"
  description="Esta página no existe. Volvé al inicio para ver mi trabajo."
>
  <section class="max-w-3xl mx-auto px-4 md:px-8 pt-36 md:pt-48 pb-24 min-h-[70vh]">
    <p class="text-sm md:text-[15px] font-medium text-accent">404</p>
    <h1
      class="mt-2 font-serif font-medium text-[2.5rem] md:text-6xl leading-[1.05] tracking-[-0.03em] text-balance"
    >
      Esta jugada no está en el tablero.
    </h1>
    <p class="mt-6 text-base md:text-lg leading-relaxed text-muted max-w-xl">
      La página que buscás no existe o cambió de lugar.
    </p>
    <p class="mt-2 text-[15px] leading-relaxed text-faint max-w-xl" lang="en">
      This page doesn't exist or has moved.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/"
        class="bg-ink text-chess-dark px-6 py-3.5 rounded-sm font-semibold text-[15px] hover:bg-white transition-colors"
      >
        Volver al inicio
      </a>
      <a
        href="/en/"
        class="border border-[#2F3541] text-ink px-6 py-3.5 rounded-sm font-medium text-[15px] hover:border-accent hover:text-accent transition-colors"
      >
        Go to the English site
      </a>
    </div>
  </section>
</Layout>
